	"item": [
		{
			"name": "Stock & Movement",
			"item": [
				{
					"name": "Get Stock Level",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": {
							"raw": "{{baseUrl}}/stock/4521",
							"host": ["{{baseUrl}}"],
							"path": ["stock", "4521"]
						},
						"description": "Retrieve stock level and batch (Lot) information for a specific item."
					}
				},
				{
					"name": "Register Movement (In/Out)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" },
							{ "key": "Content-Type", "value": "application/json", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"itemId\": 4521,\n    \"stockId\": null,\n    \"quantity\": 5,\n    \"type\": \"In\",\n    \"reason\": \"PurchaseReceipt\",\n    \"referenceId\": \"PO-2026-00789\",\n    \"notes\": \"Emergency purchase receipt\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/movement",
							"host": ["{{baseUrl}}"],
							"path": ["movement"]
						}
					}
				},
				{
					"name": "Stock Take (Adjustment)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"stockId\": 1002,\n    \"actualQuantity\": 6,\n    \"reason\": \"Monthly Physical Count\",\n    \"notes\": \"Discrepancy of 1 unit found\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/stocktake",
							"host": ["{{baseUrl}}"],
							"path": ["stocktake"]
						}
					}
				}
			]
		},
